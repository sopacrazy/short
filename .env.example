# IA Principal
OPENAI_API_KEY=sk-proj-...

# Banco de Dados
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=eyJ...  # service_role key do painel Supabase

# Narração IA — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Geração de Imagens via Replicate (Flux 1.1 Pro)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# Publicação no YouTube (opcional)
# 1. Crie um projeto em https://console.cloud.google.com
# 2. Ative a "YouTube Data API v3"
# 3. Crie credenciais OAuth 2.0 (Tipo: Aplicativo Web)
# 4. Adicione http://localhost:3001/api/youtube/callback como URI de redirecionamento
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/youtube/callback

# Backend
PORT=3001
